    h += '<div class="info-item"><div class="info-label">나누는 수</div><div class="info-label-en">Divisor</div><div class="info-value">' + d.ds + '</div></div>';
    h += '<div class="info-item gold"><div class="info-label">보수</div><div class="info-label-en">Complement</div><div class="info-value">' + d.comp + '</div></div>';
