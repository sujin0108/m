      var rowClass = isCarryRow ? 'r-carry' : 'r-prod';
      
      h += '<tr class="' + rowClass + '"><td class="lbl"></td>';
      for (var e = 0; e < extraCols; e++) h += '<td></td>';
      for (var i = 0; i < d.n; i++) {
        if (i === d.qLen) h += '<td class="sep">│</td>';
        var v = pr.vals[i];
        var cls = (hlProd && v !== null) ? 'c-hl c-new' : '';
        h += '<td class="' + cls + '">' + (v !== null ? v : '') + '</td>';
      }
      // 항상 comment 표시, 현재 행은 화살표+강조, 이전 행은 회색으로
      var cmtStyle = hlProd
        ? 'color:#FFD700;font-weight:600;'
        : 'color:rgba(196,164,132,0.55);';
      h += '<td class="cmt" style="' + cmtStyle + '">' + (hlProd ? '← ' : '') + pr.comment + '</td></tr>';
    }
    
    h += '<tr class="r-line"><td class="lbl"></td>';
    for (var e = 0; e < extraCols; e++) h += '<td></td>';
    for (var i = 0; i < d.n; i++) {
