    h += '<div class="answer-item' + (party ? ' party' : '') + '"><div class="answer-label">나머지</div><div class="answer-label-en">Remainder</div><div class="answer-value">' + rVal + '</div></div>';
    h += '</div>';
    
    if (st.adj && showAns) {
      h += '<div style="text-align:center;font-size:11px;color:#EF5350;margin-bottom:8px;font-family:-apple-system,sans-serif;">※ 나머지 Remainder (' + st.adj.oldR + ') ≥ 나누는 수 Divisor → +' + st.adj.ex + ' 조정 Adjusted</div>';
    }
    
    if (st.type === 'verify') {
      h += '<div class="verify ok' + (party ? ' party' : '') + '"><div class="verify-label">Verification 검산</div>' + d.ds + ' × ' + qVal + ' + ' + rVal + ' = ' + (d.ds * qVal + rVal) + ' ' + (st.ok ? '✓ 정답! Correct!' : '✗') + '</div>';
    }
    
    h += '</div>';
    return h;
  }
  
