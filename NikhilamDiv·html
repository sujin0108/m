  function updateStep() {
    if (!data) return;
    var st = data.steps[curStep];
    $stepBox.innerHTML = '<div class="step-box"><div class="step-num">단계 Step ' + (curStep+1) + ' / ' + data.steps.length + '</div><div class="step-desc">' + st.desc + '</div></div>';
  }
  
  function updateCtrls() {
    if (!data) return;
    $btnFirst.disabled = curStep <= 0;
    $btnPrev.disabled = curStep <= 0;
    $btnNext.disabled = curStep >= data.steps.length - 1;
    $btnLast.disabled = curStep >= data.steps.length - 1;
    $playLabel.textContent = playing ? '⏸ 정지' : '▶ 재생';
    $playLabelEn.textContent = playing ? 'Pause' : 'Play';
  }
  
  function goStep(i, withSound) {
    if (!data) return;
    if (i < 0) i = 0;
    if (i >= data.steps.length) i = data.steps.length - 1;
    var prev = curStep;
    curStep = i;
    if (withSound && curStep !== prev) {
      var st = data.steps[curStep];
      if (st.type === 'verify') {
        snd('fanfare');
        logoGlow();
        showConfetti(); // 🎉 꽃비!
      } else if (st.type === 'final') {
        snd('success');
      } else if (st.type === 'drop') {
        snd('drop');
      } else if (st.type === 'mult') {
        snd('mult');
      } else if (st.type === 'corr' || st.type === 'finalCarry') {
        snd('carry');
      } else {
        snd('click');
      }
    }
    $result.innerHTML = render(data, curStep);
    updateStep();
    updateCtrls();
    if (curStep >= data.steps.length - 1) stopPlay();
  }
  
  function startPlay() {
    if (playing || !data) return;
    if (curStep >= data.steps.length - 1) curStep = -1;
    playing = true;
    updateCtrls();
    timer = setInterval(function() { goStep(curStep + 1, true); }, 850 / speed);
  }
  
  function stopPlay() {
    playing = false;
    if (timer) { clearInterval(timer); timer = null; }
    updateCtrls();
  }
  
  function togglePlay() { if (playing) stopPlay(); else startPlay(); }
  
  function doCalc() {
    var dv = parseInt($div.value);
    var ds = parseInt($dsr.value);
    if (isNaN(dv) || isNaN(ds) || dv < 1 || ds < 1) {
      alert('올바른 숫자를 입력하세요\nPlease enter valid numbers');
      return;
    }
    stopPlay();
    data = calcNikhilam(dv, ds);
    curStep = -1;
    $ctrlPanel.style.display = 'block';
    $stepBox.innerHTML = '';
    $result.innerHTML = '';
    snd('click');
    logoGlow();
    setTimeout(startPlay, 200);
  }
  
  function updateSpeed() {
    var v = parseInt($speedSlider.value);
    speed = [0.5, 0.75, 1.0, 1.5, 2.0][v - 1];
    $speedVal.textContent = speed + 'x';
    if (playing) { stopPlay(); startPlay(); }
  }
  
  function generateProblems() {
    var problems = [];
    var divisors = [9, 89, 99, 98, 79, 97, 999, 899];
    for (var i = 0; i < 6; i++) {
      var ds = divisors[Math.floor(Math.random() * divisors.length)];
      var base = 10;
      while (base <= ds) base *= 10;
      var cLen = Math.floor(Math.log10(base));
      var qLen = Math.floor(Math.random() * 4) + 2;
      var minDv = Math.pow(10, qLen + cLen - 1);
      var maxDv = Math.pow(10, qLen + cLen) - 1;
      var dv = Math.floor(Math.random() * (maxDv - minDv + 1)) + minDv;
      problems.push({ dv: dv, ds: ds });
    }
    return problems;
  }
  
  function renderProblems() {
    var problems = generateProblems();
    var h = '';
    problems.forEach(function(p) {
      h += '<button class="ex-btn" data-d="' + p.dv + '" data-v="' + p.ds + '">' + p.dv + ' ÷ ' + p.ds + '</button>';
    });
    $exGrid.innerHTML = h;
    
    $exGrid.querySelectorAll('.ex-btn').forEach(function(btn) {
      btn.onclick = function() {
        $div.value = btn.dataset.d;
        $dsr.value = btn.dataset.v;
        stopPlay();
        $ctrlPanel.style.display = 'none';
        $stepBox.innerHTML = '';
        $result.innerHTML = '';
        data = null;
        snd('click');
      };
    });
  }
  
  function openNewTab() {
    var html = document.documentElement.outerHTML;
    var blob = new Blob([html], { type: 'text/html' });
    window.open(URL.createObjectURL(blob), '_blank');
    toast('새 탭에서 열렸습니다 Opened in new tab');
  }
  
  function copyCode() {
    navigator.clipboard.writeText(document.documentElement.outerHTML).then(function() {
      toast('코드가 복사되었습니다 Code copied');
    });
  }
  
  // 화면 보기 - 실제 결과 화면 그대로 표시
  function showPreview() {
    if (!data) {
      toast('먼저 계산을 실행하세요 Run calculation first');
      return;
    }
    // 마지막 단계(검산 완료) 화면을 그대로 복사
    var finalHtml = render(data, data.steps.length - 1);
    $modalBody.innerHTML = finalHtml;
    $previewModal.classList.add('show');
  }
  
  function copyResult() {
    if (!data) {
      toast('먼저 계산을 실행하세요 Run calculation first');
      return;
    }
    navigator.clipboard.writeText(getResultText()).then(function() {
      toast('결과가 복사되었습니다 Result copied');
    });
  }
  
  // Events
  $calcBtn.onclick = doCalc;
  $btnFirst.onclick = function() { stopPlay(); snd('click'); goStep(0, false); };
  $btnPrev.onclick = function() { stopPlay(); snd('click'); goStep(curStep - 1, false); };
  $btnPlay.onclick = function() { snd('click'); togglePlay(); };
  $btnNext.onclick = function() { stopPlay(); goStep(curStep + 1, true); };
  $btnLast.onclick = function() { stopPlay(); goStep(data.steps.length - 1, true); };
  $speedSlider.oninput = updateSpeed;
  $soundChk.onchange = function() { soundOn = $soundChk.checked; $soundToggle.classList.toggle('muted', !soundOn); };
  
  $exToggle.onclick = function() {
    exOpen = !exOpen;
    $exGrid.classList.toggle('open', exOpen);
    $exToggle.querySelector('.ko').textContent = exOpen ? '연습 문제 닫기 ▲' : '연습 문제 ▼';
  };
  
  $exRandom.onclick = function() {
    renderProblems();
    if (!exOpen) {
      exOpen = true;
      $exGrid.classList.add('open');
      $exToggle.querySelector('.ko').textContent = '연습 문제 닫기 ▲';
    }
    snd('click');
    toast('새 문제가 생성되었습니다 New problems generated');
  };
  
  $btnNewTab.onclick = openNewTab;
  $btnCopyCode.onclick = copyCode;
  $btnPreview.onclick = function() { showPreview(); $captureDropdown.classList.remove('active'); };
  $btnCopyResult.onclick = function() { copyResult(); $captureDropdown.classList.remove('active'); };
  $modalClose.onclick = function() { $previewModal.classList.remove('show'); };
  $modalCopy.onclick = function() { copyResult(); $previewModal.classList.remove('show'); };
  $previewModal.onclick = function(e) { if (e.target === $previewModal) $previewModal.classList.remove('show'); };
  
  $captureDropdown.querySelector('.util-btn').onclick = function(e) {
    e.stopPropagation();
    $captureDropdown.classList.toggle('active');
  };
  document.onclick = function() { $captureDropdown.classList.remove('active'); };
  
  document.onkeydown = function(e) {
    if (!data) return;
    if (e.key === ' ') { e.preventDefault(); togglePlay(); }
    else if (e.key === 'ArrowLeft') { stopPlay(); goStep(curStep - 1, false); }
    else if (e.key === 'ArrowRight') { stopPlay(); goStep(curStep + 1, true); }
    else if (e.key === 'Home') { stopPlay(); goStep(0, false); }
    else if (e.key === 'End') { stopPlay(); goStep(data.steps.length - 1, false); }
  };
  
  logoGlow();
  renderProblems();
  
  // 안내 패널 토글
  var $infoPanelToggle = document.getElementById('infoPanelToggle');
  var $infoPanelBody   = document.getElementById('infoPanelBody');
  $infoPanelToggle.onclick = function() {
    var open = $infoPanelBody.classList.toggle('open');
    $infoPanelToggle.classList.toggle('open', open);
  };
})();
</script>
</body>
</html>
