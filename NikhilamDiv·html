<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>니킬람 나눗셈 Nikhilam Division v16</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Courier New', Consolas, monospace;
      background: linear-gradient(135deg, #1a0a00, #2d1810, #1a0a00);
      min-height: 100vh;
      color: #F5E6D3;
      padding: 12px;
      overflow-x: hidden;
    }
    
    /* 꽃비 컨테이너 */
    .confetti-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 9999;
      overflow: hidden;
    }
    .confetti {
      position: absolute;
      width: 10px;
      height: 10px;
      opacity: 0;
    }
    @keyframes confetti-fall {
      0% { transform: translateY(-10px) rotate(0deg); opacity: 1; }
      100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
    }
    
    .header {
      text-align: center;
      padding: 10px 0 8px;
      border-bottom: 2px solid rgba(212,175,55,0.3);
      margin-bottom: 8px;
    }
    .title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 4px;
    }
    .logo {
      width: 44px;
      height: 44px;
      transition: filter 0.5s;
    }
    .logo.glow {
      filter: drop-shadow(0 0 8px rgba(212,175,55,0.8)) drop-shadow(0 0 15px rgba(212,175,55,0.5));
      animation: logoGlow 1s ease-in-out;
    }
    @keyframes logoGlow {
      0%, 100% { filter: drop-shadow(0 0 8px rgba(212,175,55,0.8)); }
      50% { filter: drop-shadow(0 0 20px rgba(212,175,55,1)) drop-shadow(0 0 30px rgba(255,215,0,0.7)); }
    }
    .title-text { text-align: left; }
    .subtitle { font-size: 20px; font-weight: 700; color: #D4AF37; font-family: -apple-system, sans-serif; }
    .subtitle-en { font-size: 11px; color: #C4A484; font-family: -apple-system, sans-serif; font-style: italic; }
    .desc { font-size: 11px; color: #C4A484; font-family: -apple-system, sans-serif; margin-top: 6px; }
    
    .util-row { display: flex; justify-content: center; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
    .util-btn {
      padding: 5px 10px;
      font-size: 10px;
      color: #C4A484;
      background: rgba(45,24,16,0.6);
      border: 1px solid rgba(212,175,55,0.25);
      border-radius: 4px;
      cursor: pointer;
      font-family: -apple-system, sans-serif;
      transition: all 0.2s;
    }
    .util-btn:hover { background: rgba(212,175,55,0.15); color: #D4AF37; }
    .util-dropdown { position: relative; display: inline-block; }
    .util-dropdown-content {
      display: none;
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(45,24,16,0.95);
      border: 1px solid rgba(212,175,55,0.3);
      border-radius: 6px;
      min-width: 140px;
      z-index: 100;
      overflow: hidden;
    }
    .util-dropdown:hover .util-dropdown-content,
    .util-dropdown.active .util-dropdown-content { display: block; }
    .util-dropdown-item {
      display: block;
      width: 100%;
      padding: 8px 12px;
      font-size: 11px;
      color: #C4A484;
      background: none;
      border: none;
      text-align: left;
      cursor: pointer;
      font-family: -apple-system, sans-serif;
    }
    .util-dropdown-item:hover { background: rgba(212,175,55,0.2); color: #D4AF37; }
    
    .main { max-width: 600px; margin: 0 auto; }
    
    .input-box {
      background: rgba(45,24,16,0.8);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      border: 1px solid rgba(212,175,55,0.2);
    }
    .input-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 12px;
      font-family: -apple-system, sans-serif;
    }
    .input-group { text-align: center; }
    .input-group .label-box { margin-bottom: 4px; }
    .input-group .label-ko { font-size: 11px; color: #D4AF37; font-weight: 600; }
    .input-group .label-en { font-size: 9px; color: #C4A484; font-style: italic; }
    .input-group input {
      width: 105px;
      height: 44px;
      font-size: 18px;
      font-weight: 600;
      text-align: center;
      background: rgba(26,10,0,0.6);
      border: 2px solid rgba(212,175,55,0.3);
      border-radius: 8px;
      color: #F5E6D3;
      outline: none;
      font-family: inherit;
    }
    .input-group input:focus { border-color: #D4AF37; }
    .div-symbol { font-size: 22px; color: #D4AF37; padding-top: 12px; }
    
    .calc-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 48px;
      font-weight: 600;
      color: #1a0a00;
      background: linear-gradient(135deg, #D4AF37, #C4A030);
      border: none;
      border-radius: 24px;
      cursor: pointer;
      font-family: -apple-system, sans-serif;
    }
    .calc-btn .ko { font-size: 14px; }
    .calc-btn .en { font-size: 10px; opacity: 0.8; }
    
    .control-panel {
      background: rgba(26,10,0,0.6);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 12px;
      border: 1px solid rgba(212,175,55,0.2);
      font-family: -apple-system, sans-serif;
    }
    .control-row { display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 10px; }
    .control-row:last-child { margin-bottom: 0; }
    
    .ctrl-btn {
      padding: 6px 10px;
      font-size: 11px;
      font-weight: 600;
      background: rgba(45,24,16,0.8);
      border: 1px solid rgba(212,175,55,0.3);
      border-radius: 6px;
      color: #D4AF37;
      cursor: pointer;
      transition: all 0.15s;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 50px;
    }
    .ctrl-btn .en { font-size: 8px; color: #C4A484; font-weight: normal; }
    .ctrl-btn:hover:not(:disabled) { background: rgba(212,175,55,0.2); }
    .ctrl-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .ctrl-btn.primary {
      background: linear-gradient(135deg, #D4AF37, #B8960C);
      color: #1a0a00;
      min-width: 70px;
    }
    .ctrl-btn.primary .en { color: rgba(26,10,0,0.7); }
    .ctrl-btn.primary:hover:not(:disabled) { background: linear-gradient(135deg, #E5C158, #D4AF37); }
    
    .speed-control { display: flex; align-items: center; gap: 8px; }
    .speed-box { display: flex; flex-direction: column; align-items: center; }
    .speed-label { font-size: 10px; color: #D4AF37; }
    .speed-label-en { font-size: 8px; color: #C4A484; font-style: italic; }
    .speed-slider { width: 70px; margin-top: 2px; }
    .speed-value { font-size: 11px; color: #D4AF37; min-width: 35px; text-align: center; }
    
    .sound-toggle {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      font-size: 10px;
      color: #C4A484;
      cursor: pointer;
    }
    .sound-toggle input { display: none; }
    .sound-toggle .sound-icon { font-size: 18px; }
    .sound-toggle .sound-label { font-size: 9px; }
    .sound-toggle.muted .sound-icon { opacity: 0.4; }
    
    .step-box {
      background: rgba(212,175,55,0.1);
      border: 1px solid rgba(212,175,55,0.25);
      border-radius: 8px;
      padding: 10px;
      margin-bottom: 12px;
      text-align: center;
      font-family: -apple-system, sans-serif;
    }
    .step-num { font-size: 10px; color: #C4A484; }
    .step-desc { font-size: 14px; color: #F5E6D3; margin-top: 3px; font-weight: 600; }
    
    .result-box {
      background: rgba(45,24,16,0.7);
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 12px;
      border: 1px solid rgba(212,175,55,0.2);
    }
    .info-row { display: flex; gap: 8px; justify-content: center; margin-bottom: 15px; font-family: -apple-system, sans-serif; }
    .info-item { padding: 6px 12px; background: rgba(26,10,0,0.5); border-radius: 6px; text-align: center; }
    .info-item.gold { border: 1px solid rgba(212,175,55,0.3); }
    .info-label { font-size: 10px; color: #D4AF37; }
    .info-label-en { font-size: 8px; color: #8B7355; font-style: italic; }
    .info-value { font-size: 15px; font-weight: 700; color: #D4AF37; margin-top: 2px; }
    
    .calc-grid {
      background: rgba(26,10,0,0.4);
      border-radius: 8px;
      padding: 15px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-bottom: 15px;
    }
    .calc-table { border-collapse: collapse; margin: 0 auto; }
    .calc-table td {
      width: 28px;
      height: 32px;
      text-align: center;
      vertical-align: middle;
      font-size: 15px;
      position: relative;
      border-right: 1px solid rgba(212,175,55,0.12);
      border-bottom: 1px solid rgba(212,175,55,0.10);
    }
    .calc-table td:first-child { border-left: none; }
    .calc-table tr:first-child td { border-top: none; }
    .calc-table td.lbl { border-right: none; border-left: none; }
    .calc-table td.cmt { border-right: none; border-left: none; }
    .calc-table td.sep { border-right: none; border-left: none; }
    .calc-table td.sep { width: 20px; color: #D4AF37; font-weight: bold; font-size: 18px; }
    .calc-table td.lbl { width: auto; min-width: 45px; text-align: right; padding-right: 8px; color: #8B7355; font-size: 13px; }
    .calc-table td.cmt { width: auto; text-align: left; padding-left: 12px; font-size: 10px; color: #C4A484; white-space: nowrap; }
    
    .r-orig td { color: #64B5F6; font-weight: 600; }
    .r-comp td { color: #81C784; }
    .r-prod td { color: #FFB74D; }
    .r-carry td { color: #F48FB1; }
    .r-line td { border-bottom: 2px solid rgba(212,175,55,0.6) !important; height: 6px !important; }
    .r-res td { color: #D4AF37; font-weight: bold; font-size: 16px; }
    
    .c-hl {
      background: rgba(255,215,0,0.45) !important;
      border-radius: 4px;
      box-shadow: 0 0 8px rgba(255,215,0,0.6);
      animation: hlGlow 0.4s ease-out;
    }
    .c-new { animation: pop 0.3s ease-out; }
    
    @keyframes hlGlow {
      0% { background: rgba(255,215,0,0.7); box-shadow: 0 0 15px rgba(255,215,0,0.8); }
      100% { background: rgba(255,215,0,0.45); box-shadow: 0 0 8px rgba(255,215,0,0.6); }
    }
    @keyframes pop {
      0% { transform: scale(0); }
      60% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }
    
    .carry-explain {
      background: rgba(244,143,177,0.15);
      border: 1px dashed #F48FB1;
      border-radius: 6px;
      padding: 8px 12px;
      margin: 8px 0;
      text-align: center;
      font-family: -apple-system, sans-serif;
      font-size: 12px;
      color: #F48FB1;
      animation: carryPulse 0.5s ease-out;
    }
    .carry-explain strong { color: #FFD54F; font-size: 14px; }
    @keyframes carryPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); background: rgba(244,143,177,0.25); }
    }
    
    .sup-carry {
      position: absolute;
      top: 0px;
      right: 1px;
      font-size: 9px;
      color: #F48FB1;
      font-weight: bold;
      background: rgba(244,143,177,0.2);
      border-radius: 3px;
      padding: 0 2px;
    }
    
    .answer-row { display: flex; justify-content: center; gap: 20px; margin-bottom: 12px; font-family: -apple-system, sans-serif; }
    .answer-item {
      padding: 12px 25px;
      background: rgba(212,175,55,0.1);
      border-radius: 10px;
      border: 2px solid rgba(212,175,55,0.3);
      text-align: center;
    }
    .answer-item.party {
      animation: party 0.5s ease-out;
      border-color: #D4AF37;
      box-shadow: 0 0 20px rgba(212,175,55,0.5);
    }
    @keyframes party {
      0%,100% { transform: scale(1); }
      30% { transform: scale(1.1) rotate(-2deg); }
      70% { transform: scale(1.1) rotate(2deg); }
    }
    .answer-label { font-size: 11px; color: #D4AF37; }
    .answer-label-en { font-size: 9px; color: #C4A484; font-style: italic; }
    .answer-value { font-size: 28px; font-weight: 700; color: #D4AF37; margin-top: 2px; }
    
    .verify {
      text-align: center;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      font-family: -apple-system, sans-serif;
    }
    .verify.ok { background: rgba(129,199,132,0.2); color: #81C784; border: 2px solid rgba(129,199,132,0.4); }
    .verify.party { animation: party 0.5s ease-out; box-shadow: 0 0 20px rgba(129,199,132,0.4); }
    .verify-label { font-size: 10px; color: #A5D6A7; font-style: italic; margin-bottom: 4px; }
    
    .ex-section { margin-bottom: 12px; font-family: -apple-system, sans-serif; }
    .ex-header { display: flex; gap: 8px; margin-bottom: 8px; }
    .ex-toggle {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 42px;
      color: #D4AF37;
      background: rgba(45,24,16,0.7);
      border: 1px solid rgba(212,175,55,0.3);
      border-radius: 8px;
      cursor: pointer;
    }
    .ex-toggle .ko { font-size: 12px; }
    .ex-toggle .en { font-size: 9px; color: #C4A484; font-style: italic; }
    .ex-random {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0 15px;
      height: 42px;
      color: #81C784;
      background: rgba(45,24,16,0.7);
      border: 1px solid rgba(129,199,132,0.3);
      border-radius: 8px;
      cursor: pointer;
      font-size: 11px;
    }
    .ex-random .en { font-size: 8px; color: #A5D6A7; font-style: italic; }
    .ex-random:hover { background: rgba(129,199,132,0.15); }
    .ex-grid { display: none; grid-template-columns: 1fr 1fr; gap: 6px; }
    .ex-grid.open { display: grid; }
    .ex-btn {
      height: 36px;
      font-size: 11px;
      color: #F5E6D3;
      background: rgba(26,10,0,0.5);
      border: 1px solid rgba(212,175,55,0.2);
      border-radius: 6px;
      cursor: pointer;
    }
    .ex-btn:hover { background: rgba(212,175,55,0.1); }
    
    .footer { text-align: center; padding: 10px; color: #8B7355; font-size: 10px; font-family: -apple-system, sans-serif; }
    
    /* ── 모바일 반응형 ── */
    @media (max-width: 480px) {
      /* 제어 버튼: 작은 화면에서 텍스트 줄이기 */
      .ctrl-btn { min-width: 44px; padding: 6px 7px; font-size: 10px; }
      .ctrl-btn.primary { min-width: 58px; }
      .ctrl-btn .en { font-size: 7px; }
      
      /* 속도 슬라이더 짧게 */
      .speed-slider { width: 55px; }
      
      /* 테이블 셀 살짝 축소 */
      .calc-table td { width: 24px; height: 28px; font-size: 13px; }
      .calc-table td.sep { width: 16px; font-size: 16px; }
      .calc-table td.lbl { min-width: 38px; font-size: 11px; }
      .calc-table td.cmt { font-size: 9px; padding-left: 8px; max-width: 120px; white-space: nowrap; }
      .r-res td { font-size: 14px; }
      
      /* 답 영역 */
      .answer-value { font-size: 22px; }
      .answer-item { padding: 10px 16px; }
    }
    
    @media (max-width: 360px) {
      /* iPhone SE 등 아주 좁은 화면 */
      .ctrl-btn { min-width: 38px; padding: 5px 5px; font-size: 9px; gap: 4px; }
      .ctrl-btn.primary { min-width: 50px; }
      .control-row { gap: 4px; }
      
      .calc-table td { width: 21px; height: 26px; font-size: 12px; }
      .calc-table td.lbl { min-width: 32px; font-size: 10px; padding-right: 5px; }
      .calc-table td.cmt { font-size: 8px; max-width: 90px; }
      
      .input-group input { width: 90px; font-size: 16px; height: 40px; }
      .answer-item { padding: 8px 12px; }
      .answer-value { font-size: 20px; }
    }
    
    .toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(45,24,16,0.95);
      color: #D4AF37;
      padding: 10px 20px;
      border-radius: 8px;
      border: 1px solid rgba(212,175,55,0.4);
      font-size: 12px;
      font-family: -apple-system, sans-serif;
      z-index: 1000;
      animation: toastIn 0.3s ease-out;
    }
    @keyframes toastIn {
      from { opacity: 0; transform: translateX(-50%) translateY(20px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.85);
      z-index: 500;
      align-items: center;
      justify-content: center;
      padding: 15px;
    }
    .modal-overlay.show { display: flex; }
    .modal-content {
      background: linear-gradient(135deg, #1a0a00, #2d1810);
      border: 2px solid rgba(212,175,55,0.5);
      border-radius: 16px;
      padding: 20px;
      max-width: 95%;
      max-height: 90%;
      overflow: auto;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; font-family: -apple-system, sans-serif; }
    .modal-title { font-size: 16px; color: #D4AF37; font-weight: 600; }
    .modal-title-en { font-size: 11px; color: #C4A484; font-style: italic; margin-left: 8px; }
    .modal-close { background: none; border: none; color: #C4A484; font-size: 28px; cursor: pointer; line-height: 1; }
    .modal-body { color: #F5E6D3; font-size: 14px; line-height: 1.6; }
    .modal-footer { margin-top: 15px; display: flex; justify-content: center; gap: 10px; }
    
    .final-celebration { animation: celebrate 1s ease-out; }
    @keyframes celebrate {
      0% { transform: scale(1); }
      10% { transform: scale(1.02); }
      20% { transform: scale(1); }
      30% { transform: scale(1.02); }
      40% { transform: scale(1); }
    }
    
    /* ── 니킬람 안내 패널 ── */
    .info-panel {
      background: rgba(26,10,0,0.55);
      border: 1px solid rgba(212,175,55,0.22);
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
      font-family: -apple-system, sans-serif;
    }
    .info-panel-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 15px;
      background: none;
      border: none;
      cursor: pointer;
      color: #D4AF37;
      font-family: inherit;
    }
    .info-panel-toggle .left  { display: flex; align-items: center; gap: 8px; }
    .info-panel-toggle .icon  { font-size: 20px; }
    .info-panel-toggle .label-ko { font-size: 15px; font-weight: 700; color: #D4AF37; }
    .info-panel-toggle .label-en { font-size: 12px; color: #C4A484; font-style: italic; margin-left: 4px; }
    .info-panel-toggle .arrow  { font-size: 13px; color: #C4A484; transition: transform 0.25s; }
    .info-panel-toggle.open .arrow { transform: rotate(180deg); }
    
    .info-panel-body {
      display: none;
      padding: 0 15px 18px;
    }
    .info-panel-body.open { display: block; }
    
    /* 핵심 원리 카드 */
    .info-principle {
      background: rgba(212,175,55,0.08);
      border-left: 3px solid #D4AF37;
      border-radius: 0 8px 8px 0;
      padding: 12px 14px;
      margin-bottom: 14px;
      font-size: 14px;
      color: #F0DFC0;
      line-height: 1.8;
    }
    .info-principle .principle-title {
      font-size: 15px; font-weight: 700; color: #D4AF37; margin-bottom: 6px;
    }
    .info-principle .highlight { color: #FFD700; font-weight: 600; }
    
    /* 나누는 수 적합성 표 */
    .divisor-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 13px; }
    .divisor-table th {
      background: rgba(212,175,55,0.15);
      color: #D4AF37;
      padding: 8px 8px;
      text-align: center;
      font-weight: 700;
      border-bottom: 1px solid rgba(212,175,55,0.25);
      font-size: 13px;
    }
    .divisor-table td {
      padding: 7px 8px;
      text-align: center;
      border-bottom: 1px solid rgba(212,175,55,0.08);
      color: #F0DFC0;
      vertical-align: middle;
      font-size: 13px;
    }
    .divisor-table tr:last-child td { border-bottom: none; }
    .badge {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 600;
    }
