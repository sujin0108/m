    var hlFinal = hl && (hl.type === 'final' || hl.type === 'verify');
    
    h += '<tr class="r-res"><td class="lbl"></td>';
    // 올림으로 늘어난 앞쪽 추가 열(들)
    for (var e = 0; e < extraCols; e++) {
      var ev = resArr[e] !== undefined ? resArr[e] : null;
