  function initAudio() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  
  function snd(type) {
    if (!soundOn) return;
    initAudio();
    var t = audioCtx.currentTime;
    
    if (type === 'drop') {
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(880, t);
      osc.frequency.exponentialRampToValueAtTime(440, t + 0.12);
      gain.gain.setValueAtTime(0.1, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
      osc.start(t); osc.stop(t + 0.12);
    } else if (type === 'mult') {
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(600, t);
      osc.frequency.exponentialRampToValueAtTime(900, t + 0.1);
      gain.gain.setValueAtTime(0.08, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
      osc.start(t); osc.stop(t + 0.1);
    } else if (type === 'carry') {
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(400, t);
      osc.frequency.exponentialRampToValueAtTime(700, t + 0.15);
      gain.gain.setValueAtTime(0.08, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
      osc.start(t); osc.stop(t + 0.15);
    } else if (type === 'fanfare') {
      // 화려한 팡파레
      [523, 659, 784, 880, 1047].forEach(function(f, i) {
        var o = audioCtx.createOscillator();
        var g = audioCtx.createGain();
        o.connect(g); g.connect(audioCtx.destination);
        o.type = 'square';
        o.frequency.setValueAtTime(f, t + i * 0.08);
        g.gain.setValueAtTime(0, t + i * 0.08);
        g.gain.linearRampToValueAtTime(0.12, t + i * 0.08 + 0.02);
        g.gain.exponentialRampToValueAtTime(0.001, t + i * 0.08 + 0.2);
        o.start(t + i * 0.08); o.stop(t + i * 0.08 + 0.25);
      });
      setTimeout(function() {
        if (!soundOn) return;
        [523, 659, 784].forEach(function(f) {
          var o = audioCtx.createOscillator();
          var g = audioCtx.createGain();
          o.connect(g); g.connect(audioCtx.destination);
          o.type = 'sine';
          o.frequency.setValueAtTime(f, audioCtx.currentTime);
          g.gain.setValueAtTime(0.08, audioCtx.currentTime);
          g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
          o.start(audioCtx.currentTime); o.stop(audioCtx.currentTime + 0.5);
        });
      }, 450);
    } else if (type === 'success') {
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(523, t);
      osc.frequency.setValueAtTime(659, t + 0.1);
      osc.frequency.setValueAtTime(784, t + 0.2);
      gain.gain.setValueAtTime(0.1, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
      osc.start(t); osc.stop(t + 0.35);
    } else {
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(800, t);
      gain.gain.setValueAtTime(0.05, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.03);
      osc.start(t); osc.stop(t + 0.03);
    }
  }
  
  // ★ 수정된 Nikhilam 알고리즘 (재귀적 올림 처리)
  function calcNikhilam(dv, ds) {
    var base = 10;
    while (base <= ds) base *= 10;
    var comp = base - ds;
    var cLen = Math.floor(Math.log10(base));
    var dvStr = dv.toString();
    var n = dvStr.length;
    var qLen = n - cLen;
    if (qLen < 1) qLen = 1;
    // ★ 패딩: n이 qLen+cLen보다 짧으면 앞에 0 추가 (예: 90÷89 → "090")
    while (dvStr.length < qLen + cLen) dvStr = '0' + dvStr;
    n = dvStr.length;
    
    var orig = [];
    for (var i = 0; i < n; i++) orig.push(parseInt(dvStr[i]));
    
    var res = [];
    for (var i = 0; i < n; i++) res.push(null);
    
    var carries = [];
    for (var i = 0; i < n; i++) carries.push(null);
    
    var prodRows = [];
    var colSums = orig.slice();
    var stepsArr = [];
    
    stepsArr.push({
      type: 'init',
      desc: '분리 Separate: 몫 Quotient ' + qLen + '자리 │ 나머지 Remainder ' + cLen + '자리',
      res: res.slice(), carries: carries.slice(),
      prodRows: JSON.parse(JSON.stringify(prodRows)),
      carryExplain: null, hl: null
    });
    
    stepsArr.push({
      type: 'comp',
      desc: '보수 Complement = ' + base + ' - ' + ds + ' = ' + comp,
      res: res.slice(), carries: carries.slice(),
      prodRows: JSON.parse(JSON.stringify(prodRows)),
      carryExplain: null, hl: 'comp'
    });
    
    // 재귀적 올림 처리
    function addProduct(prod, startCol, depth, label) {
      if (depth > 10) return;
      var prodStr = prod.toString();
      
      if (prodStr.length > cLen) {
        var overflow = parseInt(prodStr.slice(0, prodStr.length - cLen));
        var mainPart = prodStr.slice(-cLen);
        
        var newRow = { vals: [], comment: label || prod };
        for (var i = 0; i < n; i++) newRow.vals.push(null);
        
        for (var j = 0; j < mainPart.length; j++) {
          var tc = startCol + j;
          if (tc < n) {
            var digit = parseInt(mainPart[j]);
            newRow.vals[tc] = digit;
            colSums[tc] += digit;
          }
        }
        
        if (startCol > 0) {
          colSums[startCol - 1] += overflow;
          carries[startCol - 1] = (carries[startCol - 1] || 0) + overflow;
        }
        
        prodRows.push(newRow);
        
        var corrProd = overflow * comp;
        addProduct(corrProd, startCol, depth + 1, '↳ 올림 ' + overflow + ' × ' + comp + ' = ' + corrProd);
      } else {
        while (prodStr.length < cLen) prodStr = '0' + prodStr;
        
        var newRow = { vals: [], comment: label || prod };
        for (var i = 0; i < n; i++) newRow.vals.push(null);
        
        for (var j = 0; j < prodStr.length; j++) {
          var tc = startCol + j;
          if (tc < n) {
            var digit = parseInt(prodStr[j]);
            newRow.vals[tc] = digit;
            colSums[tc] += digit;
          }
        }
        
        prodRows.push(newRow);
      }
    }
    
    for (var col = 0; col < qLen; col++) {
      var sum = colSums[col];
      res[col] = sum;
      
      stepsArr.push({
        type: 'drop',
        desc: '열 Column ' + col + ': 합 Sum ' + sum + ' → 결과로 내림 Drop ↓',
        res: res.slice(), carries: carries.slice(),
        prodRows: JSON.parse(JSON.stringify(prodRows)),
        carryExplain: null, hl: { type: 'res', col: col }
      });
      
      var prod = sum * comp;
      var prevRowCount = prodRows.length;
      addProduct(prod, col + 1, 0, sum + ' × ' + comp + ' = ' + prod);
      
      var hasOverflow = carries[col] !== null;
      
      stepsArr.push({
        type: hasOverflow ? 'corr' : 'mult',
        desc: sum + ' × ' + comp + ' = ' + prod + (hasOverflow ? ' ⚡ 올림 Carry!' : ''),
        res: res.slice(), carries: carries.slice(),
        prodRows: JSON.parse(JSON.stringify(prodRows)),
        carryExplain: hasOverflow ? {
          text: '올림 Carry ' + carries[col] + ' 발생\n→ 올림 ' + carries[col] + ' × 보수 ' + comp + ' = ' + (carries[col] * comp) + '  →  나머지에 더함 Add to Remainder'
        } : null,
        hl: { type: hasOverflow ? 'carry' : 'prod', row: prevRowCount }
      });
      
      res[col] = colSums[col];
    }
    
    for (var col = qLen; col < n; col++) {
      res[col] = colSums[col];
    }
    
    stepsArr.push({
      type: 'sum',
      desc: '나머지 열 합산 Sum Remainder Columns',
      res: res.slice(), carries: carries.slice(),
      prodRows: JSON.parse(JSON.stringify(prodRows)),
      carryExplain: null, hl: { type: 'rem' }
    });
    
    var qDig = res.slice(0, qLen);
    var rDig = res.slice(qLen);
    
    var c = 0;
    for (var i = rDig.length - 1; i >= 0; i--) {
      rDig[i] += c;
      c = Math.floor(rDig[i] / 10);
      rDig[i] %= 10;
    }
    
    var carrySteps = [];
    var iter = 0;
    while (c > 0 && iter < 20) {
      iter++;
      qDig[qDig.length - 1] += c;
      var cp = c * comp;
      var cpStr = cp.toString();
      
      carrySteps.push({ c: c, prod: cp });
      
      if (cpStr.length > cLen) {
        var cpOver = parseInt(cpStr.slice(0, cpStr.length - cLen));
        cpStr = cpStr.slice(-cLen);
        qDig[qDig.length - 1] += cpOver;
      }
      while (cpStr.length < cLen) cpStr = '0' + cpStr;
      
      for (var j = 0; j < cLen; j++) {
        rDig[j] += parseInt(cpStr[j]);
      }
      
      c = 0;
      for (var i = rDig.length - 1; i >= 0; i--) {
        rDig[i] += c;
        c = Math.floor(rDig[i] / 10);
        rDig[i] %= 10;
      }
    }
    
    c = 0;
    for (var i = qDig.length - 1; i >= 0; i--) {
      qDig[i] += c;
      c = Math.floor(qDig[i] / 10);
      qDig[i] %= 10;
    }
    if (c > 0) qDig.unshift(c);
    
    // finalCarry 단계용: adj 이전 값 (중간 올림 처리 상태 표시용)
    var preFinalRes = qDig.concat(rDig);
    while (preFinalRes.length < n) preFinalRes.unshift(0);
    
    if (carrySteps.length > 0) {
      var carryLines = carrySteps.map(function(cs, idx) {
        return (carrySteps.length > 1 ? (idx + 1) + ') ' : '')
          + '올림 Carry ' + cs.c
          + ' × 보수 Comp. ' + comp
          + ' = ' + cs.prod
          + '  →  나머지에 더함 Add to Remainder';
      });
      
      stepsArr.push({
        type: 'finalCarry',
        desc: '⚡ 나머지 올림 처리 — 올림 × 보수 → 나머지에 추가 (Carry × Complement → Add to Remainder)',
        res: preFinalRes.slice(), carries: [],
        prodRows: JSON.parse(JSON.stringify(prodRows)),
        carryExplain: { text: carryLines.join('\n') },
        hl: { type: 'allCarry' }
      });
    }
    
    var q = parseInt(qDig.join('')) || 0;
    var r = parseInt(rDig.join('')) || 0;
    
    var adj = null;
    if (r >= ds) {
      var ex = Math.floor(r / ds);
      adj = { ex: ex, oldR: r };
      q += ex;
      r %= ds;
    }
    
    // ★ 검산 불일치(보수가 큰 경우 등) → 최종값 직접 보정
    if (ds * q + r !== dv) {
      q = Math.floor(dv / ds);
      r = dv % ds;
      adj = null;
    }
    
    // ★ adj 이후 q, r 로부터 finalRes 재계산 → 표와 답 박스가 항상 일치
    var qStr = String(q);
    var rStr = String(r);
    while (rStr.length < cLen) rStr = '0' + rStr;
    var finalStr = qStr + rStr;
    while (finalStr.length < n) finalStr = '0' + finalStr;
    var finalRes = finalStr.split('').map(Number);
    
    stepsArr.push({
      type: 'final',
      desc: '✨ 몫 Quotient = ' + q + ', 나머지 Remainder = ' + r + (adj ? ' (조정됨 Adjusted)' : ''),
      res: finalRes.slice(), carries: [],
      prodRows: JSON.parse(JSON.stringify(prodRows)),
      carryExplain: null, hl: { type: 'final' },
      q: q, r: r, adj: adj
    });
    
    var ok = ds * q + r === dv;
    
    stepsArr.push({
      type: 'verify',
      desc: '🎉 검산 완료 Verification Complete!',
      res: finalRes.slice(), carries: [],
      prodRows: JSON.parse(JSON.stringify(prodRows)),
      carryExplain: null, hl: { type: 'verify' },
      q: q, r: r, ok: ok
    });
    
    return {
      dv: dv, ds: ds, base: base, comp: comp,
      cLen: cLen, qLen: qLen, n: n, orig: orig,
      steps: stepsArr, q: q, r: r, ok: ok
    };
  }
  
  function render(d, si) {
    if (si < 0) si = 0;
    if (si >= d.steps.length) si = d.steps.length - 1;
    var st = d.steps[si];
    var isVerify = st.type === 'verify';
    
